# Public WhatsApp number used by the floating admin support button.
# Bangladesh format is fine: 017XXXXXXXXX or international 8801XXXXXXXXX
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=01636050980

# Optional: canonical site URL used by sitemap/robots.
NEXT_PUBLIC_SITE_URL=https://ewu-studyhub-web.vercel.app

# Optional server-side storage quota used by StudyHub's upload guardrail and
# Admin → Storage Health. Do not invent this value: set it to the actual
# storage allowance for the Supabase project/plan you are using.
# Example: 1073741824 for 1 GiB.
STUDYHUB_STORAGE_QUOTA_BYTES=
