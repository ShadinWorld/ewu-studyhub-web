# Public WhatsApp number used by the floating admin support button.
# Bangladesh format is fine: 017XXXXXXXXX or international 8801XXXXXXXXX
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=01636050980

# Optional: canonical site URL used by sitemap/robots.
NEXT_PUBLIC_SITE_URL=https://ewu-studyhub-web.vercel.app

# Server-only Google Gemini API key for EWU StudyHub AI.
GEMINI_API_KEY=
# Primary AI model for document understanding, conversational intent and sensitive verification checks.
GEMINI_MODEL=gemini-3.7-flash
# Lower-cost/free-tier model for simple intent parsing and metadata tasks.
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# AI resilience / model routing
GEMINI_SELLER_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=900
GEMINI_RETRY_MAX_MS=8000
# Seller AI fast-path inline threshold. PDFs use a more conservative limit.
GEMINI_SELLER_FAST_INLINE_MB=30
